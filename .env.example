# =============================================================================
#  Human-Gated AI Copilot — environment
#  Copy to .env.local and fill in. See PLAN.md §4 for where each value comes from.
# =============================================================================

# --- World ID / Selfie Check -------------------------------------------------
# developer.worldcoin.org → create app → copy the app id (app_xxxxx)
NEXT_PUBLIC_WLD_APP_ID=app_
# The action you created in the Developer Portal
NEXT_PUBLIC_WLD_ACTION=human-gate
# "sandbox" for the Sandbox World App, "production" for the real one.
# Keep this on sandbox for the hackathon.
NEXT_PUBLIC_WLD_ENV=sandbox
# Relying-party id from the Developer Portal (rp_xxxxx)
WLD_RP_ID=rp_
# RP signing key — signs the RpContext server-side. NEVER expose to the client.
WLD_RP_PRIVATE_KEY=

# --- The Graph ---------------------------------------------------------------
# thegraph.com/studio/apikeys → connect wallet → Create API Key.
# One key serves both Gateway GraphQL and the Subgraph MCP server.
GRAPH_API_KEY=

# --- Bazantic ----------------------------------------------------------------
# No API key: x402 authenticates each call by payment.
# The x402/MPP Gateway URL Bazantic gives you after building the gateway
BAZANTIC_GATEWAY_URL=https://
# Path of the paid endpoint on that gateway, e.g. /assess
BAZANTIC_RECIPE_ENDPOINT=
# BURNER wallet private key (0x + 64 hex) that pays for x402 calls. Never a
# personal wallet. Settles on Base Sepolia (see src/lib/bazantic/x402.ts).
X402_PRIVATE_KEY=
# Optional: base URL used in approval links. Defaults to the origin the
# request arrived on (e.g. https://echobrief.online), which is usually right.
# PUBLIC_BASE_URL=https://echobrief.online

# --- Agent -------------------------------------------------------------------
# Google AI Studio → Get API key (free tier is enough for the demo)
GEMINI_API_KEY=
# Optional. Any Gemini model with function calling.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Storage (Redis) ---------------------------------------------------------
# REQUIRED on Vercel, optional locally. Add the Upstash Redis integration from
# the Vercel Marketplace and these are injected automatically (either naming
# scheme works). Leave unset locally to use the file store in .data/kv/.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Offline dev switches ----------------------------------------------------
# Set to 1 to run without live credentials. MUST stay off for the demo:
# The Graph prize explicitly disqualifies mocked data, and the UI shows a
# "MOCK DATA" badge whenever any of these is on.
MOCK_GRAPH=0
MOCK_WORLDID=0
MOCK_BAZANTIC=0
